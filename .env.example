# Copy this file to .env or .env.local and fill in values from
# Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Approved Google account emails for app access
# Use comma-separated values, for example:
# VITE_ALLOWED_ADMINS=user1@example.com,user2@example.com
# VITE_ALLOWED_WORKERS=user3@example.com
VITE_ALLOWED_ADMINS=
VITE_ALLOWED_WORKERS=
