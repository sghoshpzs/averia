# Copy to functions/.env and fill in your real shop details — that file is
# gitignored (see .gitignore) so this info never ends up committed/public,
# unlike src/config/shopConfig.js which is part of the public repo.
#
# Firebase Functions loads .env automatically (both locally and once
# deployed) — no code changes needed after editing it, just redeploy:
#   firebase deploy --only functions
SHOP_NAME=
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
